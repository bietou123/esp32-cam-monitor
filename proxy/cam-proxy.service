[Unit]
Description=ESP32-CAM reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/cam-proxy.env
ExecStart=/usr/bin/python3 /opt/cam-proxy/proxy.py
Restart=always
RestartSec=3
User=nobody
# 摄像头与代理在同一网段时无需额外权限；若端口 <1024 再去掉 User 或加 CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
